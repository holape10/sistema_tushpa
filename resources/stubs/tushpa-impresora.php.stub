<?php
/**
 * AGENTE DE IMPRESIÓN - SISTEMA TUSHPA
 * -------------------------------------
 * Va en la PC donde están conectadas las impresoras. Se queda escuchando al servidor y, apenas
 * llega un ticket (comprobante, comanda, precuenta...), lo imprime directo, sin vista previa.
 *
 * Cómo usarlo:
 *   1. Esta PC necesita PHP (por ejemplo el de Laragon/XAMPP) con la extensión openssl si el servidor es https.
 *   2. Comparte en Windows cada impresora USB (Propiedades de impresora > Compartir) con el nombre
 *      que pusiste en el sistema, o usa impresoras de red (IP, puerto 9100).
 *   3. Ejecuta:   php tushpa-impresora.php
 *      Para que arranque solo con Windows, crea un acceso directo a un .bat con esa línea
 *      en la carpeta  shell:startup
 *
 * Esta clave es solo para esta sucursal. Si descargas otro agente desde el sistema, este deja de funcionar.
 */

const SERVIDOR = '__SERVIDOR__';
const TOKEN = '__TOKEN__';
const ESPERA = 20; // segundos que el servidor mantiene abierta cada consulta (long-polling)

date_default_timezone_set('America/Lima');
set_time_limit(0);

function registro(string $mensaje): void
{
    echo '[' . date('d/m/Y H:i:s') . '] ' . $mensaje . PHP_EOL;
}

function http(string $metodo, string $ruta, ?array $datos = null, int $timeout = 10): ?array
{
    $opciones = [
        'http' => [
            'method' => $metodo,
            'header' => "X-Token: " . TOKEN . "\r\nAccept: application/json\r\nContent-Type: application/json\r\n",
            'content' => $datos ? json_encode($datos) : '',
            'timeout' => $timeout,
            'ignore_errors' => true,
        ],
    ];
    $respuesta = @file_get_contents(SERVIDOR . $ruta, false, stream_context_create($opciones));
    if ($respuesta === false) {
        return null;
    }
    $estado = 0;
    foreach ($http_response_header ?? [] as $h) {
        if (preg_match('#^HTTP/\S+\s+(\d{3})#', $h, $m)) {
            $estado = (int) $m[1];
        }
    }
    if ($estado === 401) {
        registro('CLAVE NO VÁLIDA: descarga de nuevo el agente desde el sistema (Mantenimiento > Impresoras).');
        sleep(30);
        return null;
    }
    return $estado >= 200 && $estado < 300 ? json_decode($respuesta, true) : null;
}

/** Envía los bytes ESC/POS a la impresora. Devuelve '' si salió bien o el mensaje de error. */
function imprimir(array $t, string $bytes): string
{
    $ruta = trim((string) $t['ruta']);

    if ($t['tip_conex_imp'] === 'RED') {
        [$ip, $puerto] = array_pad(explode(':', $ruta), 2, 9100);
        $con = @fsockopen($ip, (int) $puerto, $errno, $errstr, 5);
        if (!$con) {
            return "No se pudo conectar a $ip:$puerto ($errstr)";
        }
        stream_set_timeout($con, 10);
        $escrito = fwrite($con, $bytes);
        fclose($con);
        return $escrito === strlen($bytes) ? '' : 'La impresora no recibió todo el ticket';
    }

    // Impresora compartida en Windows: se copia el archivo en bruto a \\localhost\NOMBRE
    $destino = str_starts_with($ruta, '\\\\') ? $ruta : '\\\\localhost\\' . $ruta;
    $tmp = tempnam(sys_get_temp_dir(), 'tsh');
    file_put_contents($tmp, $bytes);
    exec('copy /b ' . escapeshellarg($tmp) . ' ' . escapeshellarg($destino) . ' 2>&1', $salida, $codigo);
    @unlink($tmp);
    return $codigo === 0 ? '' : 'No se pudo imprimir en ' . $destino . ': ' . trim(implode(' ', $salida));
}

registro('Agente de impresión iniciado. Servidor: ' . SERVIDOR);
$errores = 0;

while (true) {
    $r = http('GET', '/api/impresion/trabajos?espera=' . ESPERA, null, ESPERA + 15);

    if ($r === null) {
        $errores++;
        if ($errores === 1 || $errores % 20 === 0) {
            registro('Sin conexión con el servidor, reintentando...');
        }
        sleep(min(10, $errores));
        continue;
    }
    if ($errores) {
        registro('Conectado.');
        $errores = 0;
    }

    foreach ($r['trabajos'] ?? [] as $t) {
        $error = imprimir($t, base64_decode((string) $t['contenido']));
        registro(($error === '' ? 'OK  ' : 'ERR ') . $t['tipo'] . ' ' . $t['referencia'] . ' -> ' . $t['descripcion'] . ($error ? " | $error" : ''));
        http('POST', '/api/impresion/resultado', ['id' => $t['id'], 'ok' => $error === '', 'error' => $error ?: null]);
    }
}
